<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 合并进 Duolo.app 的 Info.plist。声明支持的语言，macOS 才会按系统语言运行应用
     （界面里的 navigator.languages、系统菜单项都依赖它）。与 app/src/i18n 的语言列表保持一致。 -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
    <string>ja</string>
    <string>ko</string>
    <string>es</string>
    <string>fr</string>
    <string>de</string>
    <string>pt-BR</string>
    <string>ru</string>
    <string>it</string>
    <string>tr</string>
    <string>vi</string>
    <string>id</string>
  </array>
  <key>NSMicrophoneUsageDescription</key>
  <string>Duolo uses the microphone for voice input.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Duolo turns your speech into text for the coding agent.</string>
</dict>
</plist>
