# 部署用的本机配置。复制成 deploy/.env.deploy 再填（deploy/deploy.sh init 会帮你复制），那个文件不进仓库。

# 登录服务器：用户@地址。不是 root 时这个用户要能免密码 sudo。
DUOLO_SSH=deploy@203.0.113.10
DUOLO_SSH_PORT=22
# 不填就用 ~/.ssh/config 或默认的私钥。
DUOLO_SSH_KEY=

# 主域名；www.<主域名> 跳到它。
DUOLO_DOMAIN=duolo.io
# 跳到主域名的其他域名，空格分开（www 也跳）。
DUOLO_REDIRECT_DOMAINS="duolo.cc"
# Let's Encrypt 的联系邮箱。
DUOLO_CERT_EMAIL=ops@example.com
# 主域名在 Cloudflare 开了代理（橙色云朵）时设为 1：Nginx 只信任 Cloudflare 给的客户端地址。
DUOLO_CLOUDFLARE=0

# APISIX 在服务器本机监听的端口（宿主机 Nginx 转给它），不要和服务器上别的服务冲突。
DUOLO_APISIX_PORT=9480
# APISIX 后面的服务端实例「主机:端口:优先级」：优先级高的是主，低的是备用。
DUOLO_UPSTREAM_NODES="server-1:8787:1 server-2:8787:0"

# 只有 db-init 用：托管 PostgreSQL 的管理员连接串，用完可以删掉。
DUOLO_DB_ADMIN_URL=
