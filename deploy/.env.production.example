# Duolo 服务端在服务器上的环境变量（见 server/src/config.ts）。复制成 deploy/.env.production 再填，
# deploy/deploy.sh setup 把它上传到服务器的 /opt/duolo/shared/.env.production。这个文件不进仓库。

# 对外的地址：登录链接、二维码里都用它。
PUBLIC_URL=https://duolo.io
# 登录会话的签名密钥，至少 32 个字符（deploy.sh init 会随机生成）。
BETTER_AUTH_SECRET=
# PostgreSQL 连接串（deploy.sh db-init 会建好库并写在文件末尾）。
# DATABASE_URL=postgres://duolo:密码@主机:5432/duolo

# 语音识别（豆包），不填就不能用语音输入。
DOUBAO_ASR_API_KEY=
# VOICE_DAILY_MINUTES=120
# VOICE_ANONYMOUS_DAILY_MINUTES=30
# 语音整理成文字用的模型接口（OpenAI 兼容），不填就不整理。
# VOICE_ORGANIZE_BASE_URL=
# VOICE_ORGANIZE_API_KEY=
# VOICE_ORGANIZE_MODEL=
