# APISIX 的路由（standalone 模式）。部署脚本把 __NODES__ 换成上游的 Duolo 服务端，__HOST__ 换成域名，
# 生成 apisix.yaml；APISIX 发现文件变了会自己重新加载，不用重启。文件必须以 #END 结尾。
#
# 主备：服务端现在只支持单个实例（在线设备的连接在进程内存里，见 server/src/relay.ts），同一个账号的设备
# 必须连在同一台上。所以平时只用 priority 最高的节点，它不健康时才用下一个（发布时轮流重启就不断线）。
# 服务端支持跨实例转发之后，把各节点的 priority 设成一样，就是多台同时分流。
upstreams:
  - id: duolo-server
    type: roundrobin
    scheme: http
    pass_host: pass
    timeout:
      connect: 5
      send: 60
      read: 3600
    retries: 1
    nodes:
__NODES__
    checks:
      active:
        type: http
        http_path: /health
        timeout: 3
        healthy:
          interval: 5
          successes: 1
        unhealthy:
          interval: 2
          http_failures: 2
          tcp_failures: 2
          timeouts: 2
      passive:
        healthy:
          http_statuses: [200, 201, 204, 301, 302, 400, 401, 403, 404]
          successes: 3
        unhealthy:
          http_statuses: [502, 503, 504]
          tcp_failures: 2
          timeouts: 3
routes:
  - id: duolo
    uris:
      - /*
    hosts:
      - __HOST__
    enable_websocket: true
    upstream_id: duolo-server
#END
