{
  "name": "duolo-server",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "description": "Duolo server: accounts, device pairing and end-to-end encrypted relay between a Mac and phones",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --no-warnings src/main.ts",
    "start": "node --no-warnings dist/main.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mobile-sandbox": "tsx --no-warnings dev/mobile-sandbox.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "better-auth": "1.7.18",
    "fastify": "^5.12.8",
    "pg": "8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "ws": "^8.23.0"
  }
}
